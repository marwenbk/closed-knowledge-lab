# Local PostgreSQL
POSTGRES_USER=topmed
POSTGRES_PASSWORD=topmed
POSTGRES_DB=topmed
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://topmed:topmed@localhost:5433/topmed
TOPMED_TEST_DATABASE_URL=postgresql+psycopg://topmed:topmed@localhost:5433/postgres

# Backend
APP_NAME="TopMed API"
APP_ENV=development
LOG_LEVEL=INFO
EXPECTED_DATASET_ID=topmed-demo
EXPECTED_DATASET_VERSION=2.0.0

# Local embeddings and retrieval
EMBEDDING_MODEL_ID=intfloat/multilingual-e5-small
EMBEDDING_MODEL_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
EMBEDDING_MODEL_FILE=onnx/model_qint8_avx512_vnni.onnx
EMBEDDING_MODEL_SHA256=dd476dd0c2514e9b9be83aeb3853fac0763e0bdf4a71645407587d77c48a2d88
EMBEDDING_TOKENIZER_SHA256=0b44a9d7b51c3c62626640cda0e2c2f70fdacdc25bbbd68038369d14ebdf4c39
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_LENGTH=512
EMBEDDING_CACHE_DIR=.cache/models
VECTOR_TOP_K=10
LEXICAL_TOP_K=10
TRIGRAM_TOP_K=10
FINAL_CONTEXT_K=6
RRF_K=60
MIN_VECTOR_SIMILARITY=0.75
TRIGRAM_MIN_SIMILARITY=0.30
TRIGRAM_FALLBACK_ENABLED=true
SECOND_HOP_ENABLED=true

# Grounded generation
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash
PROMPT_VERSION=1.0.0
LLM_TIMEOUT_SECONDS=180
LLM_MAX_OUTPUT_TOKENS=768
LLM_TEMPERATURE=0
SETTINGS_VERSION=1.0.0

# Local widget sessions and realtime delivery
WIDGET_ASSISTANT_KEY=topmed-local-demo
WIDGET_TOKEN_SECRET=topmed-local-development-token-secret
WIDGET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WIDGET_SESSION_TTL_SECONDS=3600
WIDGET_ASSISTANT_LABEL="TopMed Guide"
AUTO_HANDOFF_ON_CONFLICT=true
AUTO_HANDOFF_ON_NOT_ANSWERABLE=false
AUTO_HANDOFF_ON_PARTIAL=false
REVIEW_BEFORE_SEND_ENABLED=false
SSE_KEEPALIVE_SECONDS=15
SSE_POLL_INTERVAL_SECONDS=0.5
SSE_REPLAY_LIMIT=500

# Local administrator (choose a private password with at least 12 characters)
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_BOOTSTRAP_EMAIL=admin@topmed.local
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_DISPLAY_NAME="TopMed Admin"

# Customer widget
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WIDGET_ASSISTANT_KEY=topmed-local-demo
FRONTEND_BIND_HOST=127.0.0.1
FRONTEND_PORT=3000
